{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TaskManager",
  "version": "0.1.0",
  "identifier": "com.taskmanager.quadrant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "四象限任务管理",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": []
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": [
          "$APP_DATA_DIR"
        ],
        "deny": [
          "$HOME"
        ]
      }
    }
  }
}
