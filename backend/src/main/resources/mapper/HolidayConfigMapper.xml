<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.taskcalendar.mapper.HolidayConfigMapper">

    <!-- 批量插入休息日配置 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO holiday_config (year, date, type, description, created_at, updated_at)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (
                #{item.year},
                #{item.date},
                #{item.type},
                #{item.description},
                NOW(),
                NOW()
            )
        </foreach>
    </insert>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, year, date, type, description, created_at, updated_at
    </sql>

</mapper>