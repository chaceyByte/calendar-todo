# Java项目忽略规则
## 编译输出
.idea/
.idea/**
./backend/target/**
/target/
/target/**
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# 更精确的Maven构建输出忽略
backend/target/
backend/target/**
!backend/target/classes/META-INF/
backend/target/classes/!META-INF/MANIFEST.MF

# Spring Boot特定文件
backend/target/classes/application*.yml
backend/target/classes/application*.properties
backend/target/classes/static/
backend/target/classes/templates/

# Maven构建相关
backend/target/maven-archiver/
backend/target/maven-status/
backend/target/surefire-reports/
backend/target/test-classes/
backend/target/*.jar
backend/target/*.war

## 打包忽略
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

## 运行时数据文件
*.log
*.tmp
*.temp
logs/
log/
*.log.*

## IDE文件
### IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

### Eclipse
.classpath
.project
.settings/
bin/

### NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/

### VS Code
.vscode/

## 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Vue项目忽略规则
## 依赖目录
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

## 构建输出
dist/
build/
.cache/
.parcel-cache/

# Vite构建输出
frontend/dist/
frontend/.vite/
frontend/node_modules/

## 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

## 日志文件
*.log

## 编辑器目录和文件
.vscode/
.idea/
*.swp
*.swo

## 测试覆盖率目录
coverage/
.nyc_output/

## 依赖锁定文件 (建议提交)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

## 临时文件
.tmp/
temp/

## 其他
*.tgz
*.tar.gz

# 数据库文件 (如果使用本地数据库)
*.db
*.sqlite
*.sqlite3

# 本地配置文件
local.config.js
local.config.ts

# 其他构建产物
*.class
*.exe
*.dll
*.so
*.dylib
